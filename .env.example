# ─── Clerk Auth ─────────────────────────────────────────────────────────────
# Get these from your Clerk Dashboard → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=replace-with-clerk-secret-key

# Frontend — same publishable key, prefixed for Vite
VITE_CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Only needed when running Clerk behind a custom domain proxy
# VITE_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# ─── Groq AI ────────────────────────────────────────────────────────────────
# Get from console.groq.com → API Keys
GROQ_API_KEY=replace-with-groq-api-key

# ─── SAP HANA Cloud ─────────────────────────────────────────────────────────
# Leave unset to run in in-memory mode (data resets on restart)
# Set all three to enable SAP HANA Cloud persistence
HANA_HOST=your-instance.hana.prod-apXX.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=YourSecurePassword
